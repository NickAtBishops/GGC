# Runtime artifacts — generated by the app, don't belong in git
jobs/
img_cache/
extraction_cache/

# Seller financials and per-deal output workbooks — never commit
# (NDA / PII risk; CLAUDE.md §12.4 calls out that seller financials need
# to be gated behind Firebase Auth, not left in a public source tree).
Outputs/

# Per-deal analysis dumps include extracted PDF text from seller
# financials — same NDA risk as Outputs/. If a specific dump file is
# safe to share (e.g. OUTLINE.md, CHANGES.md), copy it out first.
analysis_dumps/

# Template backups generated by patch scripts (.preLTO.bak, etc.)
*.preLTO.bak
*.pre*.bak

# Web app (Next.js) build artifacts + local env
web/node_modules/
web/.next/
web/.env.local

# Secrets — never commit these
.env
*.key
*.pem

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp

# Logs
*.log

gcp-credentials.json
*.json.key