# Production env vars baked into the Next.js build (Vercel reads this
# during `next build` in production mode). The Vercel CLI's `env add`
# was silently saving empty values for NEXT_PUBLIC_ENGINE_URL on this
# project (CLI v54.14.0 stdin-stripping bug), so we pin the value in
# repo instead. Safe — this URL is a public Cloud Run endpoint, not a
# secret.
#
# To change the engine URL: edit this file, commit, push. Vercel
# auto-deploys (when GitHub integration root dir is correct) or run
# `cd web && vercel deploy --prod` manually.

NEXT_PUBLIC_ENGINE_URL=https://ggc-deal-engine-584170940040.us-central1.run.app
